    "ask": [
      "Bash(aws * create-*)",
      "Bash(aws * run-*)",
      "Bash(aws * put-*)",
      "Bash(aws * update-*)",
      "Bash(aws * attach-*)",
      "Bash(aws * detach-*)",
      "Bash(aws s3 mb*)",
      "Bash(aws * s3 mb*)",
      "Bash(aws s3 cp*)",
      "Bash(aws * s3 cp*)",
      "Bash(aws s3 sync*)",
      "Bash(aws * s3 sync*)",
      "Bash(aws cloudformation deploy*)",
      "Bash(aws * cloudformation deploy*)",
      "Bash(docker exec*)",
      "Bash(docker compose exec*)",
      "Bash(docker inspect*)",
      "Bash(curl *localhost*)",
      "Bash(curl *127.0.0.1*)",
      "Bash(wget *localhost*)",
      "Bash(wget *127.0.0.1*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  }
}
