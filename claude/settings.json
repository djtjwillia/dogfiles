{
  "model": "sonnet",
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "/Users/taylor/.claude/statusline-command.sh"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Burning", "Steelpushing", "Ironpulling", "Tineyeing", "Smoldering",
      "Rioting", "Soothing", "Snapping", "Storing", "Tapping", "Sparking",
      "Preserving", "Ruining", "Splintering", "Ascending",
      "Surgebinding", "Awakening"
    ]
  },
  "permissions": {
    "deny": [
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(export -p*)",
      "Bash(ps e*)",
      "Bash(security find-generic-password*)",
      "Bash(security find-internet-password*)",
      "Bash(security dump-keychain*)",
      "Bash(tcpdump*)",
      "Bash(gh auth token*)",
      "Bash(aws configure export-credentials*)",
      "Bash(aws * configure export-credentials*)",
      "Bash(aws configure get*)",
      "Bash(aws * configure get*)",
      "Bash(aws secretsmanager get-secret-value*)",
      "Bash(aws * secretsmanager get-secret-value*)",
      "Bash(aws ssm get-parameter*)",
      "Bash(aws * ssm get-parameter*)",
      "Bash(aws kms decrypt*)",
      "Bash(aws * kms decrypt*)",
      "Bash(aws sts assume-role*)",
      "Bash(aws * sts assume-role*)",
      "Bash(aws sts get-session-token*)",
      "Bash(aws * sts get-session-token*)",
      "Bash(aws iam create-access-key*)",
      "Bash(aws * iam create-access-key*)",
      "Bash(aws * delete-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws s3 rm*)",
      "Bash(aws * s3 rm*)",
      "Bash(aws s3 rb*)",
      "Bash(aws * s3 rb*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/sso/**)",
      "Read(~/.aws/cli/**)",
      "Read(~/.aws/credentials*)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config*)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)"
