{
  "model": "sonnet",
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "type": "command",
    "command": "/Users/taylor/.claude/statusline-command.sh"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Burning", "Steelpushing", "Ironpulling", "Tineyeing", "Smoldering",
      "Rioting", "Soothing", "Snapping", "Storing", "Tapping", "Sparking",
      "Preserving", "Ruining", "Splintering", "Ascending",
      "Surgebinding", "Awakening"
    ]
  },
  "permissions": {
    "deny": ["Artifact", "Workflow"]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  }
}
